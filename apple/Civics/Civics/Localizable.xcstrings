      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No text-to-speech voice is available. Enable a voice in Settings › Accessibility › Spoken Content › Voices to hear questions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay ninguna voz de texto a voz disponible. Active una voz en Ajustes › Accesibilidad › Contenido leído › Voces para escuchar las preguntas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未找到可用的语音合成声音。请在 设置 › 辅助功能 › 朗读内容 › 声音 中启用一个声音。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找不到可用的語音合成聲音。請在 設定 › 輔助使用 › 語音內容 › 聲音 中啟用一個聲音。"
          }
        }
      }
    },
    "listen.onboarding" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Press Start, put your phone away, and answer each question out loud. On AirPods: one press to hear the answer or continue, two presses for the next question, three to repeat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse Comenzar, guarde el teléfono y responda cada pregunta en voz alta. Con AirPods: una pulsación para escuchar la respuesta o continuar, dos para la siguiente pregunta y tres para repetir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击开始，把手机放到一边，大声回答每道题。AirPods：按一下听答案或继续，按两下下一题，按三下重复本题。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點按開始，把手機放到一邊，大聲回答每道題。AirPods：按一下聽答案或繼續，按兩下下一題，按三下重複本題。"
          }
        }
      }
    },
