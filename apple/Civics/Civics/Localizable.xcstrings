    },
    "listen.onboarding" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Press Start, put your phone away, and answer each question out loud. On AirPods: one press to hear the answer or continue, two presses for the next question, three to repeat." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "点击开始，把手机放到一边，大声回答每道题。AirPods：按一下听答案或继续，按两下下一题，按三下重复本题。" } }
      }
    },
    "listen.acceptableAnswer" : {
